# Applies as you type, in editors and tools that never run Prettier.
# Prettier also reads this as a fallback for the options it shares.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 2
max_line_length = 80

# npm normalises these to two spaces on every install; don't fight it.
[{package.json,package-lock.json}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
