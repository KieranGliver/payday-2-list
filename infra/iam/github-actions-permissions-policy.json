      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::pd2-tracker-dev-227415629009-us-east-2-an"
    },
    {
      "Sid": "WriteSiteObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
