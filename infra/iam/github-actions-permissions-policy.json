    },
    {
      "Sid": "InvalidateDistribution",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:aws:cloudfront::227415629009:distribution/EG8NVRFZ6H85A"
    }
  ]
}
