# Local development. Copy to .env.local (same directory) and fill in.
# NEVER prefix with VITE_ - that would inline the key into the browser bundle.

# From https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Who to report on, as steamid:name pairs.
PD2_PLAYERS=76561198103504838:yogizmo,76561198096708910:Eggsenbacon

# Lambda only - SSM SecureString holding the key, used instead of STEAM_API_KEY.
# STEAM_API_KEY_PARAM=/pd2-tracker/dev/steam-api-key
