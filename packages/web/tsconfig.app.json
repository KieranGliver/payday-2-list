{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"jsx": "react-jsx",
		"allowImportingTsExtensions": true,
		"allowArbitraryExtensions": true,

		/* Path alias for shadcn/ui. baseUrl is deprecated in TS 6, but the shadcn
       CLI needs it to resolve "@" to a real directory - without it the CLI
       writes components into a literal "@" folder. */
		"ignoreDeprecations": "6.0",
		"baseUrl": ".",
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["src"]
}
