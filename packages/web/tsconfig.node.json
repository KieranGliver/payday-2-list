{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"lib": ["ES2023"],
		"types": ["node"],

		/* nodenext, not bundler: vite.config.ts is evaluated by node. This is what
       forces explicit .js extensions on relative imports in shared and api.
       moduleResolution must be overridden too, or it inherits bundler and
       conflicts. */
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowImportingTsExtensions": true
	},
	"include": ["vite.config.ts"]
}
